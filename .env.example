# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, or local Postgres).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/agrosight"

# --- AI Assistant (optional) ---
# Which provider to use: "anthropic" or "openai". Leave unset to disable the AI panel.
AI_PROVIDER="anthropic"

# Only one of these is required, matching AI_PROVIDER above.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional: override the default model id for the selected provider.
# AI_MODEL="claude-sonnet-5"
